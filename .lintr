linters: linters_with_defaults(
    cyclocomp_linter(15),
    line_length_linter(120),
    indentation_linter = NULL
  )
exclusions: list(
    "R/ccsr.R" = list(cyclocomp_linter = Inf),
    "R/comorbidity.R" = list(cyclocomp_linter = Inf),
    "R/cost-example.R" = list(cyclocomp_linter = Inf),
    "R/dx-sensitivity.R" = list(cyclocomp_linter = Inf),
    "R/labels.R" = list(cyclocomp_linter = Inf),
    "R/nis-new-study.R" = list(cyclocomp_linter = Inf),
    "R/suppress.R" = list(cyclocomp_linter = Inf),
    "tests/testthat/helper-ccsr.R" = list(line_length_linter = Inf)
  )
encoding: "UTF-8"
